rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'superAdmin';
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'superAdmin');
    }
    
    function isCustomer() {
      return isAuthenticated() && getUserData().role == 'customer';
    }
    
    function isPackaging() {
      return isAuthenticated() && getUserData().role == 'packaging';
    }
    
    function isDelivery() {
      return isAuthenticated() && getUserData().role == 'delivery';
    }
    
    function isActive() {
      return getUserData().isActive == true && getUserData().isDeleted == false;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // System collection
    match /system/{document=**} {
      // Allow unauthenticated read for setup check
      allow read: if true;
      // Allow unauthenticated create for first-time setup
      allow create: if true;
      // Admin can update/delete
      allow update, delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Read access:
      // - Allow all reads (security enforced at application level)
      // - Needed for: first-time setup, login, user profile access
      allow read: if true;
      
      // Create access:
      // - IMPORTANT: Allow unauthenticated create for FIRST SUPER ADMIN setup only
      //   (Application logic in FirstUserSetupNotifier ensures only one user can be created this way)
      // - Super Admin: can create any user
      // - Admin: can create users (except super admin role)
      allow create: if true;
      
      // Delete access:
      // - Only super admin can delete users
      allow delete: if isSuperAdmin() && isActive();
      
      // Update access:
      // - Users: can update ONLY their lastLogin field (for login tracking) - MUST BE FIRST to avoid circular dependency
      // - Super Admin: can update all users (except role)
      // - Admin: can update users (except role)
      // - Users: can update their own profile (limited fields only)
      allow update: if (request.auth != null 
                        && request.auth.uid == userId 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])) ||
                       (isSuperAdmin()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'username', 'email', 'createdAt', 'createdBy'])) ||
                       (isAdmin()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'username', 'email', 'createdAt', 'createdBy'])) ||
                       (isAuthenticated() 
                        && isOwner(userId) 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'isDeleted', 'username', 'email', 'createdAt', 'createdBy']));
    }
    
    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Allow create for authenticated users and first-time setup
      allow create: if true;
      allow update, delete: if false;
    }
    
    // Branches - Admin full access, others read
    match /branches/{branchId} {
      // Allow read for all authenticated users
      allow read: if request.auth != null;
      // Allow write for authenticated users (admin check done at app level)
      allow create, update, delete: if request.auth != null;
    }
    
    // Hubs - Admin full access, others read
    match /hubs/{hubId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Apartments - Admin full access, others read
    match /apartments/{apartmentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Customers - Admin full access, others read
    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Farmers - Admin full access, others read
    match /farmers/{farmerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Products - Admin full access, others read
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Categories - Admin full access, others read
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Units - Admin full access, others read
    match /units/{unitId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Operational Schedules - Admin full access, others read
    match /operational_schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Orders - Role-based access
    match /orders/{orderId} {
      // TEMPORARY: Allow all authenticated users full access for debugging
      // TODO: Add proper role-based restrictions after confirming auth works
      allow read, write: if request.auth != null;
    }
    
    // Deliveries - Role-based access
    match /deliveries/{deliveryId} {
      // Admin has full access
      allow read, write: if isAdmin() && isActive();
      
      // Delivery personnel can read assigned deliveries
      allow read: if isAuthenticated() 
                  && isDelivery() 
                  && isActive()
                  && resource.data.assignedTo == request.auth.uid;
      
      // Delivery personnel can update assigned deliveries
      allow update: if isAuthenticated() 
                    && isDelivery() 
                    && isActive()
                    && resource.data.assignedTo == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'location', 'updatedAt']);
    }
    
    // App Settings - Admin only
    match /app_settings/{settingId} {
      // Admin can read and write settings
      allow read, write: if isAdmin() && isActive();
    }
    
    // Settings - Admin only (for payment settings, etc.)
    match /settings/{settingId} {
      // Admin can read and write settings
      allow read, write: if isAdmin() && isActive();
    }
    
    // Transactions - Admin and related users
    match /transactions/{transactionId} {
      // Admin has full access
      allow read, write: if isAdmin() && isActive();
      
      // Users can read their own transactions
      allow read: if isAuthenticated() 
                  && isActive()
                  && (resource.data.userId == request.auth.uid 
                      || resource.data.customerId == request.auth.uid
                      || resource.data.farmerId == request.auth.uid);
    }
    
    // Bills - Admin and customers
    match /bills/{billId} {
      // Any authenticated user can create and read bills
      // Security enforced at application level
      allow create, read: if request.auth != null;
      
      // Only authenticated users can update bills
      allow update: if request.auth != null;
      
      // Only admin can delete bills
      allow delete: if isAdmin() && isActive();
    }
    
    // Notifications - Admin only
    match /notifications/{notificationId} {
      // Admin has full access
      allow read, write: if isAdmin() && isActive();
      
      // System can create notifications (for WhatsApp, SMS, etc.)
      allow create: if isAuthenticated();
      
      // Users can read their own notifications
      allow read: if isAuthenticated() 
                  && isActive()
                  && resource.data.customerId == request.auth.uid;
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
