rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 
             && request.resource.contentType.matches('image/.*');
    }
    
    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if (isOwner(userId) || isAdmin()) && isValidImage();
    }
    
    // Product images - public read, authenticated write/delete
    match /product_images/{fileName} {
      allow read: if true;  // Public read for product images
      allow write, delete: if isAuthenticated();  // Authenticated users can upload/delete
    }
    
    // Legacy product images path (for backward compatibility)
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }
    
    // Farmer images
    match /farmers/{farmerId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidImage();
    }
    
    // Order documents
    match /orders/{orderId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
